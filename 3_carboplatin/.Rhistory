colnames(cnv) <- get_patient_id(colnames(cnv))
cnv <- cnv[, !duplicated(colnames(cnv))]
saveRDS(cnv, paste0("../data/procdata/tmp_cnv_", proj, ".rds"))
}
# 3. Save Metadata with Patient ID
meta_piece <- data.frame(
Sample_ID = get_patient_id(patient_ids),
Project = proj,
stringsAsFactors = FALSE
)
# Remove duplicates if a patient had two vials
meta_piece <- meta_piece[!duplicated(meta_piece$Sample_ID), ]
write.csv(meta_piece, paste0("../data/procdata/tmp_meta_", proj, ".csv"), row.names = FALSE)
rm(mae, mae_common); gc()
}
