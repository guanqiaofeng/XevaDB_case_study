## updated function for merge snv
merge_snv_union <- function(projects) {
message("--- Starting SNV Union Merge (Targeting ~16k+ Genes) ---")
# 1. First pass: Identify ALL unique genes across all cohorts
all_unique_genes <- c()
for (proj in projects) {
file <- paste0("../data/procdata/tmp_snv_", proj, ".rds")
if (file.exists(file)) {
current_genes <- rownames(readRDS(file))
all_unique_genes <- union(all_unique_genes, current_genes)
}
}
total_genes <- length(all_unique_genes)
message(paste("Total unique genes identified:", total_genes))
# 2. Second pass: Build the merged matrix using the master gene list
merged_df <- NULL
for (proj in projects) {
file <- paste0("../data/procdata/tmp_snv_", proj, ".rds")
if (!file.exists(file)) next
current <- readRDS(file)
colnames(current) <- substr(colnames(current), 1, 12)
current <- current[, !duplicated(colnames(current)), drop = FALSE]
# Create a template matrix of 0s for missing genes in this cohort
# This ensures every cohort provides the same set of genes
missing_genes <- setdiff(all_unique_genes, rownames(current))
if (length(missing_genes) > 0) {
zero_mat <- matrix(0,
nrow = length(missing_genes),
ncol = ncol(current),
dimnames = list(missing_genes, colnames(current)))
# Combine existing mutations with 0s for missing genes
current_full <- rbind(current, zero_mat)
} else {
current_full <- current
}
# Ensure row order is identical for the cbind
current_full <- current_full[all_unique_genes, , drop = FALSE]
if (is.null(merged_df)) {
merged_df <- current_full
} else {
merged_df <- cbind(merged_df, current_full)
}
message(paste("> Added", proj, "- Total samples now:", ncol(merged_df)))
rm(current, current_full, zero_mat); gc()
}
# 3. Save the final union matrix
output_path <- paste0("../data/procdata/TCGA_merged_snv.csv")
write.csv(merged_df, output_path)
message(paste("--- Success! Final matrix size:", nrow(merged_df), "genes x", ncol(merged_df), "samples ---"))
}
# Run the union merge
merge_snv_union(projects)
