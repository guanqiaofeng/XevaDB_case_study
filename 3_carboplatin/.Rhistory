# 1. Re-define a specific merge function for SNV with verbose stats
merge_snv_verbose <- function(projects) {
message("--- Starting Verbose SNV Merge ---")
merged_df <- NULL
for (proj in projects) {
file <- paste0("../data/procdata/tmp_snv_", proj, ".rds")
if (!file.exists(file)) {
message(paste("! Skipping", proj, "- file not found."))
next
}
current <- readRDS(file)
colnames(current) <- substr(colnames(current), 1, 12)
current <- current[, !duplicated(colnames(current)), drop = FALSE]
# Statistics for the current cohort
n_genes_current <- nrow(current)
n_samples_current <- ncol(current)
if (is.null(merged_df)) {
merged_df <- current
message(paste("> Initialized with", proj, ":", n_genes_current, "genes,", n_samples_current, "samples"))
} else {
# CHECKING THE OVERLAP
genes_in_both <- intersect(rownames(merged_df), rownames(current))
genes_only_in_merged <- setdiff(rownames(merged_df), rownames(current))
genes_only_in_new <- setdiff(rownames(current), rownames(merged_df))
message(paste0("> Adding ", proj, ": ", n_genes_current, " genes found."))
message(paste0("  - Genes in common: ", length(genes_in_both)))
message(paste0("  - Genes lost if we intersect: ", length(genes_only_in_merged) + length(genes_only_in_new)))
# OPTION A: If you want 16k genes, we should use UNION, not INTERSECT
# Let's see what happens if we use the intersection logic you had:
merged_df <- cbind(merged_df[genes_in_both, , drop = FALSE],
current[genes_in_both, , drop = FALSE])
message(paste("  - New running total genes:", nrow(merged_df)))
}
rm(current); gc()
}
output_path <- paste0("../data/procdata/TCGA_merged_snv_DEBUG.csv")
write.csv(merged_df, output_path)
message(paste("--- SNV Merge Complete. Final Row Count:", nrow(merged_df), "---"))
}
# 2. Run it
merge_snv_verbose(projects)
