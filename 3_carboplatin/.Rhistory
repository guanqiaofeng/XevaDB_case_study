merge_chunks <- function(type, projects) {
message(paste("Merging", type, "..."))
merged_df <- NULL
for (proj in projects) {
file <- paste0("../data/procdata/tmp_", type, "_", proj, ".rds")
if (!file.exists(file)) next
current <- readRDS(file)
# Standardize column names to the first 12 characters (Patient ID)
colnames(current) <- substr(colnames(current), 1, 12)
# Remove any duplicate columns within the current project
# (e.g., if a patient has multiple samples in one cohort)
current <- current[, !duplicated(colnames(current)), drop = FALSE]
if (is.null(merged_df)) {
merged_df <- current
} else {
# Intersection of rows to ensure we only keep genes found in ALL cohorts
common_genes <- intersect(rownames(merged_df), rownames(current))
# Combine the dataframes
merged_df <- cbind(merged_df[common_genes, , drop = FALSE],
current[common_genes, , drop = FALSE])
}
# Clean up memory after each cohort
rm(current)
gc()
}
# Final safety check: ensure no duplicate columns across the entire merged set
if (!is.null(merged_df)) {
merged_df <- merged_df[, !duplicated(colnames(merged_df)), drop = FALSE]
output_path <- paste0("../data/procdata/TCGA_merged_", type, ".csv")
write.csv(merged_df, output_path, row.names = TRUE)
message(paste("Successfully saved:", output_path))
}
rm(merged_df)
gc()
}
