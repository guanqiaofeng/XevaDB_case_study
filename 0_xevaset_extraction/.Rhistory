files <- c(
"ddf38d71-5acf-4b09-9796-d26fa1089daa_wxs_gdc_realn.bam",
"35a96eee-113b-45cb-a999-81c13545b104_wxs_gdc_realn.bam",
"2761c6e7-affc-4ffe-a72a-1d1203d574c4_wxs_gdc_realn.bam",
"7e8f250c-6162-4049-8559-5bfdf054b021_wxs_gdc_realn.bam",
"4cdd2f93-e0d1-4420-bf4d-ba004cc0599c_wxs_gdc_realn.bam",
"e6feb69a-8827-4d43-94aa-036cf5150549_wxs_gdc_realn.bam"
)
# extract UUID
uuid <- sub("_.*", "", files)
df <- data.frame(
filename = files,
file_id = uuid,
stringsAsFactors = FALSE
)
View(df)
# Map file IDs → TCGA barcodes
df$barcode <- UUIDtoBarcode(df$file_id, from_type = "file_id")
library(jsonlite)
library(curl)
uuid_to_barcode <- function(uuid) {
url <- paste0(
"https://api.gdc.cancer.gov/files/", uuid,
"?expand=cases.samples.portions.analytes.aliquots"
)
x <- tryCatch(fromJSON(curl(url)), error = function(e) NULL)
if (is.null(x$data)) return(NA)
bc <- x$data$cases$samples$portions$analytes$aliquots$submitter_id[1]
return(bc)
}
# run the function
df$barcode <- sapply(df$file_id, uuid_to_barcode)
df
# Standard R script for the curation stage
library(AnnotationGx)
library(data.table)
library(dplyr)
# Load the preprocessed (but unannotated) drug file
#drug <- fread(snakemake@input[[1]]) |> as.data.frame()
input_file <- "data/procdata/drug_screen/build/drug.csv"
drug <- fread(input_file) |> as.data.frame()
# Filter for single agents (AnnotationGx works best here)
drugs_to_map <- drug %>%
filter(is.ADC == "no", is.PDC == "no", is.single == "yes") %>%
pull(drugname.standardized)
# Map and Fetch
message("📡 Querying PubChem for ", length(drugs_to_map), " compounds...")
compound_2_cids <- mapCompound2CID(drugs_to_map, first = TRUE) %>%
filter(!is.na(cids)) %>%
rename(CID = cids)
