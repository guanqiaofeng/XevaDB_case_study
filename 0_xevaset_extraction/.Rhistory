library(org.Hs.eg.db)
library(AnnotationDbi)
# Load the Gene Annotation Database
genome_gse <- org.Hs.eg.db
# Get all Ensembl gene IDs
txby <- keys(genome_gse, 'ENSEMBL')
# Map Ensembl gene IDs to HUGO symbols
gene_ids <- mapIds(genome_gse, keys=txby, column='SYMBOL', keytype='ENSEMBL', multiVals="first")
# Read the RNA-seq output file into a data frame
rna_df <- read.csv("/Users/guanqiaofeng/Documents/CesconLab/NF1/all.tsv", sep="\t", header=TRUE)
# Check the first few rows to confirm the Ensembl IDs are correct
head(rna_df$gene)
# Map Ensembl gene IDs to HUGO symbols (make sure the 'gene' column contains Ensembl IDs)
rna_df$HUGO_symbol <- gene_ids[rna_df$gene]
# Handle Missing Mappings
rna_df$HUGO_symbol[is.na(rna_df$HUGO_symbol)] <- "Unknown"
# Drop the Ensembl ID column and move HUGO symbol to the first column
rna_df <- rna_df[, c("HUGO_symbol", setdiff(names(rna_df), c("gene", "HUGO_symbol.1")))]
# Save the Updated Data with HUGO symbols as the first column
write.table(rna_df, "/Users/guanqiaofeng/Documents/CesconLab/NF1/all_hugo.tsv", sep="\t", quote = FALSE, row.names = FALSE)
